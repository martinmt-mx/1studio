# Copia este archivo como .env (o define las variables en tu sistema). Todas son opcionales.
PORT=3000
# Nombres que se muestran en el tablero
CANAL_HISTORIAS=Historias alternativas
CANAL_GAMING=Gaming clips
# Carpetas de trabajo (se crean solas junto a server.js)
CARPETA_HISTORIAS=Historias
CARPETA_GAMING=Gaming
# Rutas a herramientas si no están en el PATH
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe
# YTDLP_PATH=C:\herramientas\yt-dlp.exe
# STUDIO_PYTHON=py -3
# FONT_PATH=C:\Windows\Fonts\arialbd.ttf
